{
  "projects": {
    "default": {
      "workDir": "/tmp/gobot-workspace"
    },
    "backend": {
      "workDir": "/home/user/repos/backend"
    },
    "frontend": {
      "workDir": "/home/user/repos/frontend"
    }
  },
  "defaultProject": "default",
  "telegram": {
    "token": "123456:ABCDEFG...",
    "adminChatIDs": [123456789],
    "chatBindings": {
      "-1001234567890": "backend"
    }
  },
  "linear": {
    "apiKey": "lin_api_...",
    "webhookSecret": "your_webhook_signing_secret",
    "webhookPort": 8080,
    "triggerState": "In Progress",
    "doneState": "Done",
    "teamBindings": {
      "ENG": "backend",
      "PLAT": "frontend"
    }
  },
  "google": {
    "email": "your-bot@gmail.com",
    "clientID": "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com",
    "clientSecret": "YOUR_GOOGLE_CLIENT_SECRET",
    "refreshToken": "",
    "accessToken": "",
    "tokenExpiry": ""
  },
  "twilio": {
    "accountSID": "ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
    "authToken": "your_twilio_auth_token",
    "phoneNumber": "+15555550000"
  },
  "browser": {
    "headless": true
  }
}
