# Copy to /etc/gobot/env on the server and chmod 600

# Provider selection: "telegram" (default) or "linear"
PROVIDER=telegram

# ── Required for all providers ────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_key_here

# ── Telegram settings (required when PROVIDER=telegram) ──────────────────────
TELEGRAM_TOKEN=your_token_here

# Optional (defaults shown)
ALLOWED_CHAT_IDS=           # comma-separated int64 IDs; empty = allow all

# ── Linear settings (required when PROVIDER=linear) ──────────────────────────
LINEAR_API_KEY=lin_api_xxxxxxxxxxxx
LINEAR_WEBHOOK_SECRET=your_webhook_signing_secret

# Optional (defaults shown)
LINEAR_WEBHOOK_PORT=8080
LINEAR_TRIGGER_STATE=In Progress
LINEAR_DONE_STATE=Done
LINEAR_TEAM_REPOS=ENG:/var/lib/gobot/eng-repo,PLATFORM:/var/lib/gobot/platform-repo
LINEAR_DEFAULT_REPO=/var/lib/gobot/workspace

# ── Claude executor settings ─────────────────────────────────────────────────
CLAUDE_PATH=claude
CLAUDE_MODEL=claude-opus-4-6
CLAUDE_ALLOWED_TOOLS=Bash,Read,Edit,Write,Glob,Grep
CLAUDE_MAX_BUDGET_USD=2.00
EXEC_TIMEOUT=5m
WORK_DIR=/var/lib/gobot/workspace
